# Required on Vercel: MongoDB stores references and screenshot files (GridFS).
# Optional locally: without MongoDB, references and images use .data/.
MONGODB_URI=
MONGODB_DB=designforme
# Optional: enables detailed vision analysis for website captures and screenshots.
# Server-side only. Never prefix the key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional browser executable. macOS uses installed Google Chrome automatically.
# Other systems: run npx playwright install chromium.
# Leave unset on Vercel; the bundled serverless Chromium is selected automatically.
UIREF_BROWSER_PATH=
